# Environment variables for production (GoDaddy cPanel > Setup Node.js App > Environment variables).
# Add them one by one in that screen. Do NOT upload a .env file. Never put real values in this file or in git.

# --- required ---
NODE_ENV=production
DATABASE_URL=                 # SECRET. The Supabase PostgreSQL connection string (postgresql://user:password@host:5432/postgres)

# --- strongly recommended ---
PUBLIC_URL=https://control.nextudio.co      # the address of the live site (used for the same-site security check)

# --- company settings ---
STANDARD_MONTHLY_HOURS=176    # hours in a month used to turn a salary into an hourly labor cost (was 176 in testing; confirm the real value)

# --- optional (leave out unless needed) ---
# PDF_BROWSER_PATH=           # full path to Chrome/Chromium if the host has one (PDFs need it)
# PDF_NO_SANDBOX=true         # some Linux hosts need this for Chrome to start
# DATABASE_CA_CERT=           # the database's CA certificate (PEM text) to also verify the database server
# DB_POOL_MAX=5               # maximum simultaneous database connections
# COOKIE_SECURE=true          # login cookie is HTTPS-only (this is already the default in production)
# TRUST_PROXY=1               # how many reverse proxies sit in front of the app (1 on GoDaddy)
# FORCE_HTTPS=false           # only to disable the http->https redirect if it ever misbehaves

# PORT is supplied by the host automatically. Do not set it.
