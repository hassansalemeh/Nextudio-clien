{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for the Architecture Company Management System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:db-pull": "prisma db pull && prisma generate",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "migrate": "node dist/scripts/migrate.js",
    "migrate:status": "node dist/scripts/migrate.js --status",
    "backup": "node dist/scripts/backup.js",
    "restore": "node dist/scripts/restore.js",
    "check": "node dist/scripts/check.js",
    "create-user": "node dist/scripts/create-user.js",
    "reset-password": "node dist/scripts/reset-password.js",
    "remove-login": "node dist/scripts/remove-login.js",
    "set-name": "node dist/scripts/set-name.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pg": "^8.23.0",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "prisma": "^7.10.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18"
  }
}
